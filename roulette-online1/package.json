{
  "name": "roulette-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "命运轮盘 · 多设备联机版（黄/蓝/绿/红四色棋子步数记录 + 公平性验证）",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "node --no-warnings server/src/index.js",
    "serve": "npm run build && npm run start",
    "reset:data": "node scripts/reset-data.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
